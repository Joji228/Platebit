<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the phone through Android's cloud backup or phone-to-phone transfer.
    API keys only decrypt on the phone that saved them anyway; meals can be moved with the
    app's own Export / Import backup instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
